# Copy to .env for local development. Never commit .env.

# Postgres (docker compose service `db`)
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# Redis (docker compose service `redis`)
REDIS_URL=redis://localhost:6379/0

# API
APP_NAME=ai-support-platform
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Auth (Phase 2). Dev-only secret — change before any real deploy.
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480

# LLM: any OpenAI-compatible endpoint. Defaults target Google Gemini (free key: https://aistudio.google.com).
# The app has no rule-based fallback: without a working key, chat returns "assistant unavailable".
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Agent actions (Pass 3)
# Encrypts the credentials companies store for their connections. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (first encrypts, all decrypt). Required in production.
SECRETS_KEY=
# DEVELOPMENT ONLY: lets connections point at localhost/private addresses (needed for the demo
# company API below). Never enable in production: it disables the SSRF protection.
ALLOW_PRIVATE_CONNECTIONS=false
# Mounts a fake company API at /demo-company so the seeded Store assistant has something to call.
ENABLE_DEMO_COMPANY_API=false

# Background work (webhooks, document indexing, cleanup).
#   embedded  the API process runs it in a thread (local development)
#   external  run `python -m app.worker` as its own process (production, docker compose --profile full)
JOBS_MODE=embedded
# How long staff have to decide an approval, and how long your backend has to return an action result.
APPROVALS_TTL_HOURS=72
TOOL_RESULT_TTL_MINUTES=15
